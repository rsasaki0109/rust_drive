e (10.,11.5)\n        maximum = max(f['truth']['speed'] for f in run['frames'] if lo-1e-9<=f['time']<=hi+1e-9)\n        result['actual_hold_maximum_m_s'] = maximum\n        if maximum>.05: result['failed_gates'].append('actual_standstill')\n        if spec['world']!='blocked':\n            release = next((t['expected']['time'] for t in ticks if t['expected']['time']>=12. and t['expected']['command']['acceleration']>0.),None)\n            result['release_command_s'] = release\n            if release is None or release>22. or not run['summary']['reached_goal']: result['failed_gates'].append('clear_path_release_goal')\n        if spec['world']=='release-fault':\n            maximum = max(f['truth']['speed'] for f in run['frames'] if 13.5-1e-9<=f['time']<=14.95+1e-9)\n            result['fault_hold_maximum_m_s'] = maximum\n            if maximum>.05: result['failed_gates'].append('fault_standstill')\n    return result\n\n\ndef key(row): return tuple(row[k] for k in ['plant','world','seed','heading','kind'])\n\n\ndef compare(row, baseline):\n    verified = (not row.get('audit_error') and row.get('replay_exit_code')==0\n                and row.get('run_exit_code')==(0 if row.get('summary',{}).get('passed') else 1)\n                and row.get('replay',{}).get('verified') is True\n                and row['replay']['ticks']==row['summary']['steps'])\n    new = sorted(set(row.get('failed_gates',[]))-set(baseline['failed_gates']))\n    regression = verified and not new\n    stable = None\n    if row['world']=='mission':\n        hold = row.get('mission_hold',{})\n        stable = (verified and row.get('stop_contract',{}).get('passed') is True\n                  and row.get('verified_emergency_steps',math.inf)<=.2*baseline['verified_emergency_steps']\n                  and hold.get('samples',0)>=900 and hold.get('maximum_actual_speed_m_s',math.inf)<=.05\n                  and hold.get('positive_control_commands',1)==0)\n    return dict(regression_passed=regression, new_failed_gates=new, stable_mission_stop_passed=stable,\n                baseline_emergency_steps=baseline['verified_emergency_steps'],\n                baseline_failed_gates=baseline['failed_gates'])\n\n\ndef main():\n    parser=argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--output',type=Path,required=True)\n    parser.add_argument('--plant',choices=['all','reference-2d','rne-dynamic'],default='all')\n    parser.add_argument('--freeze-only',action='store_true')\n    parser.add_argument('--check-regression',action='store_true')\n    parser.add_argument('--baseline-results',type=Path,default=REPO/'assets/stop-search-results.json')\n    parser.add_argument('--binary',type=Path,default=REPO/'target/release/rustdriving')\n    parser.add_argument('--native-binary',type=Path,default=REPO/'integrations/rne/target/release/rustdriving-rne')\n    args=parser.parse_args(); output=args.output.resolve()\n    plants=['reference-2d','rne-dynamic'] if args.plant=='all' else [args.plant]\n    manifest=freeze(output,specifications(plants))\n    if args.freeze_only:return\n    baseline={key(r):r for r in json.loads(args.baseline_results.read_text())['baselines']}\n    binaries={'reference-2d':args.binary.resolve(),'rne-dynamic':args.native_binary.resolve()}\n    fingerprints={k:sha(binaries[k]) for k in plants};validate_inputs(output,manifest,args.binary.resolve());rows=[]\n    def one(spec):\n        folder=output/'episodes'/spec['plant']/f\"{spec['world']}-{spec['mode']}-seed-{spec['seed']}\"\n        return run_case(output,spec,binaries[spec['plant']],args.binary.resolve(),auditor=lambda r,c,t,s,f:audit(r,c,t,dict(s,_folder=str(folder)),f))\n    with ThreadPoolExecutor(max_workers=2) as pool:\n        for row in pool.map(one,manifest['episodes']):\n            row['comparison']=compare(row,baseline[key(row)]);rows.append(row)\n            report=dict(complete=len(rows)==len(manifest['episodes']),binaries=fingerprints,\n                        manifest_sha256=sha(output/'frozen-manifest.json'),episodes=rows)\n            (output/'report.json').write_text(json.dumps(report,indent=2)+'\\n')\n            print(row['plant'],row['world'],row['mode'],row['seed'],row['comparison'],row.get('audit_error'),flush=True)\n    report.update(regression_passed=all(r['comparison']['regression_passed'] for r in rows),\n                  stable_mission_stops_passed=all(r['comparison']['stable_mission_stop_passed'] for r in rows if r['world']=='mission'),\n                  strict_qualification_passed=all(r['passed'] for r in rows))\n    (output/'report.json').write_text(json.dumps(report,indent=2)+'\\n')\n    assert all(sha(binaries[k])==fingerprints[k] for k in plants)\n    if not (report['regression_passed'] and report['stable_mission_stops_passed'] if args.check_regression else report['strict_qualification_passed']):raise SystemExit(1)\n\n\nif __name__=='__main__':main()\n","scripts/test_stop_search.py":"#!/usr/bin/env python3\n\"\"\"Adversarial retention, comparison and frozen-world checks for stop search.\"\"\"\nimport copy\nfrom pathlib import Path\nimport tempfile\nimport unittest\n\nfrom check_stop_search import compare, contract, freeze, materialize, specifications\nfrom check_absolute_heading import materialize as heading_input\nfrom check_obstruction_stops import materialize as obstruction_input\nfrom check_road_width import materialize as road_input\nfrom test_obstruction_stops import config, output as original_output, sample, ticks\n\n\ndef output(*args, **kwargs):\n    value=original_output(*args, **kwargs)\n    value['command']['steering']=0.\n    return value\n\n\ndef braking():\n    value=output(path=[sample(0.,1.,0.),sample(.2,0.,.4),sample(.2,0.,8.4)],command=-2.5)\n    value['estimate']['speed']=1.\n    return value\n\n\nclass StopSearchTests(unittest.TestCase):\n    def test_a_planned_stop_arms_without_an_emergency_and_cannot_restart_on_another_prefix(self):\n        held = output(.1); result = contract(config(),ticks([braking(),held]))\n        self.assertTrue(result['passed']); self.assertEqual(result['arms'],[0.]); self.assertEqual(result['held_ticks'],1)\n        bad = output(.1,command=2.)\n        self.assertFalse(contract(config(),ticks([braking(),held,bad]))['passed'])\n        incomplete = output(.1); incomplete['trajectory']['points'][-1]['time']=7.9\n        self.assertFalse(contract(config(),ticks([braking(),held,incomplete]))['passed'])\n        self.assertEqual(contract(config(),ticks([output(command=2.)]))['arms'],[])\n\n    def test_only_a_complete_certified_candidate_releases_the_hold(self):\n        held = output(); clear = output(.1,path=[sample(0.,0.,0.),sample(40.,8.,10.)],command=2.)\n        result=contract(config(),ticks([braking(),held,clear]))\n        self.assertTrue(result['passed']);self.assertEqual(result['releases'],[.1])\n        conflict=copy.deepcopy(clear);conflict['predictions'][0]['positions']=[dict(x=20.,y=0.)]*41\n        with self.assertRaises(ValueError):contract(config(),ticks([braking(),held,conflict]))\n\n    def test_a_health_fault_cannot_release_retention_or_emit_an_unbraked_command(self):\n        held=output(); fault=output(.1,path=[sample(0.,0.,0.),sample(40.,8.,10.)],command=-6.)\n        fault['health']=['StaleGnss']\n        result=contract(config(),ticks([braking(),held,fault,output(.2)]))\n        self.assertTrue(result['passed']);self.assertEqual(result['releases'],[]);self.assertEqual(result['held_ticks'],2)\n        fault['command']['acceleration']=0.\n        self.assertFalse(contract(config(),ticks([braking(),held,fault]))['passed'])\n        fault['command']['acceleration']=float('nan')\n        with self.assertRaises(ValueError):contract(config(),ticks([braking(),held,fault]))\n\n    def test_comparison_retains_new_coverage_failures_and_requires_complete_replay(self):\n        baseline=dict(failed_gates=['source_acceptance'],verified_emergency_steps=50)\n        row=dict(world='blocked',run_exit_code=0,replay_exit_code=0,summary=dict(passed=True,steps=2),\n                 replay=dict(verified=True,ticks=2),failed_gates=[],verified_emergency_steps=0)\n        self.assertTrue(compare(row,baseline)['regression_passed'])\n        row['failed_gates']=['forecast_coverage']\n        self.assertFalse(compare(row,baseline)['regression_passed'])\n        row['failed_gates']=[];row['replay']['ticks']=1\n        self.assertFalse(compare(row,baseline)['regression_passed'])\n\n    def test_mission_stop_improvement_does_not_reclassify_the_missing_goal_as_a_pass(self):\n        baseline=dict(failed_gates=['source_acceptance'],verified_emergency_steps=50)\n        row=dict(world='mission',run_exit_code=1,replay_exit_code=0,summary=dict(passed=False,steps=1301),\n                 replay=dict(verified=True,ticks=1301),failed_gates=['source_acceptance'],verified_emergency_steps=10,\n                 stop_contract=dict(passed=True),mission_hold=dict(samples=901,maximum_actual_speed_m_s=0.,positive_control_commands=0))\n        self.assertTrue(compare(row,baseline)['stable_mission_stop_passed'])\n        self.assertEqual(row['failed_gates'],['source_acceptance'])\n        row['verified_emergency_steps']=11\n        self.assertFalse(compare(row,baseline)['stable_mission_stop_passed'])\n        row['verified_emergency_steps']=0;row['mission_hold']['maximum_actual_speed_m_s']=.051\n        self.assertFalse(compare(row,baseline)['stable_mission_stop_passed'])\n\n    def test_all_40_inputs_add_only_the_stop_search_policy_to_unchanged_preceding_worlds(self):\n        specs=specifications(['reference-2d','rne-dynamic']);self.assertEqual(len(specs),40)\n        self.assertEqual(len({(s['plant'],s['world'],s['mode'],s['seed']) for s in specs}),40)\n        for spec in specs:\n            source,value=materialize(spec);self.assertTrue(value.pop('search_obstruction_stops'))\n            if spec['family']=='heading':original=heading_input(spec)\n            elif spec['family']=='road':original=road_input(dict(spec,mode='fitted'))\n            else:original=obstruction_input(dict(spec,mode='envelope' if spec['world']=='blocked' else 'enabled',settle=True))\n            self.assertEqual((source,value),original)\n        with tempfile.TemporaryDirectory() as directory:\n            output=Path(directory);manifest=freeze(output,specs)\n            (output/manifest['episodes'][0]['scenario']).write_text('{}')\n            with self.assertRaises(ValueError):freeze(output,specs)\n\n\nif __name__=='__main__':unittest.main()\n"},"earlier_generations":{"A":{"overrides":{"crates/planning/src/stopping.rs":"//! Bounded alternatives to a rejected collision-retimed stopping position.\nuse crate::speed::{self, Limits};\nuse rustdriving_core::{TrajectoryPoint, Vec2};\n\n/// Preserve the ordinary proposal first. Every alternative rebuilds the actual\n/// reachable speed profile and sweeps its braking segments and eight-second\n/// stationary tail. Moving traffic makes feasibility non-monotonic in distance;\n/// no binary-search or endpoint-only clearance assumption is used.\npub(super) fn profile(\n    geometry: &[Vec2],\n    initial_speed: f64,\n    limits: &Limits<'_>,\n    proposed_stop: f64,\n    search: bool,\n    mut clear: impl FnMut(&[TrajectoryPoint]) -> bool,\n) -> Option<Vec<TrajectoryPoint>> {\n    let mut attempt = |stop| {\n        let path = speed::profile(geometry, initial_speed, limits, Some(stop))?;\n        clear(&path).then_some(path)\n    };\n    if let Some(path) = attempt(proposed_stop) {\n        return Some(path);\n    }\n    if !search {\n        return None;\n    }\n    // Round slightly outward at positive speeds so the braking endpoint is\n    // representable without an instantaneous speed clamp. Never extend the\n    // original stopping proposal or change the supplied braking authority.\n    let minimum = if initial_speed == 0.0 {\n        0.0\n    } else {\n        (initial_speed.powi(2) / (2.0 * limits.deceleration) * (1.0 + 1e-12)).max(1e-7)\n    };\n    if !minimum.is_finite() || minimum >= proposed_stop {\n        return None;\n    }\n    // At most sixteen extra profiles per lateral candidate. The final probe is\n    // the earliest physically reachable stop, including rest at distance zero.\n    for index in 1..=16 {\n        let stop = proposed_stop + (minimum - proposed_stop) * index as f64 / 16.0;\n        if let Some(path) = attempt(stop) {\n            return Some(path);\n        }\n    }\n    None\n}\n","crates/planning/tests/stop_search.rs":"use rustdriving_core::{DrivingMode, EgoState, Planner, Pose, Prediction, Route, Vec2};\nuse rustdriving_planning::LatticePlanner;\n\nfn point(x: f64, yaw: f64) -> Vec2 {\n    Vec2::new(x, 0.).rotated(yaw).plus(Vec2::new(12., -7.))\n}\nfn state(x: f64, speed: f64, yaw: f64) -> EgoState {\n    EgoState {\n        pose: Pose {\n            position: point(x, yaw),\n            yaw,\n        },\n        speed,\n    }\n}\nfn road(yaw: f64) -> Route {\n    Route::new(vec![point(0., yaw), point(100., yaw)], 2.1).unwrap()\n}\nfn growing(x: f64, yaw: f64) -> Prediction {\n    Prediction {\n        id: 1,\n        positions: vec![point(x, yaw); 41],\n        radius: 1.,\n        dt: 0.2,\n        additional_radius_m: (0..=40)\n            .map(|i| {\n                let t = i as f64 * 0.2;\n                0.2 + 0.3 * t + 0.05 * t * t\n            })\n            .collect(),\n    }\n}\nfn planner(search: bool) -> LatticePlanner {\n    let mut p = LatticePlanner::default();\n    p.settle_obstruction_stops = true;\n    p.search_obstruction_stops = search;\n    p\n}\n\n#[test]\nfn an_earlier_stop_repairs_retiming_without_changing_the_forecast_or_braking_authority() {\n    for yaw in [0., 0.7, -1.9] {\n        let object = growing(30., yaw);\n        let mut old = planner(false);\n        assert_eq!(\n            old.plan(state(0., 8., yaw), &road(yaw), &[object.clone()])\n                .mode,\n            DrivingMode::Emergency\n        );\n        let mut new = planner(true);\n        let p = new.plan(state(0., 8., yaw), &road(yaw), &[object.clone()]);\n        assert_eq!(p.mode, DrivingMode::Yield);\n        assert_eq!(p.points[0].speed, 8.);\n        let tail = &p.points[p.points.len() - 2..];\n        assert_eq!(tail[0].speed, 0.);\n        assert_eq!(tail[0].position, tail[1].position);\n        assert!((tail[1].time - tail[0].time - 8.).abs() < 1e-12);\n        // Independent 1 ms integration of constant acceleration, including the\n        // entire hold and every growing-radius interval, rather than chord tests.\n        for pair in p.points.windows(2) {\n            let a = pair[0];\n            let b = pair[1];\n            let dt = b.time - a.time;\n            let acceleration = (b.speed - a.speed) / dt;\n            assert!((-2.5 - 1e-9..=2.0 + 1e-9).contains(&acceleration));\n            let length = a.position.distance(b.position);\n            assert!((length - (a.speed + b.speed) * dt * 0.5).abs() < 1e-9);\n            for i in 0..=(dt * 1000.).ceil() as usize {\n                let elapsed = (i as f64 * 0.001).min(dt);\n                let time = a.time + elapsed;\n                let fraction = if length > 1e-10 {\n                    (a.speed * elapsed + 0.5 * acceleration * elapsed * elapsed) / length\n                } else {\n                    0.\n                };\n                let position = a\n                    .position\n                    .plus(b.position.minus(a.position).scaled(fraction));\n                let step = (time / 0.2).min(40.);\n                let index = step.floor() as usize;\n                let next = (index + 1).min(40);\n                let extra = object.additional_radius_m[index]\n                    + (object.additional_radius_m[next] - object.additional_radius_m[index])\n                        * (step - index as f64);\n                assert!(\n                    position.distance(object.positions[0])\n                        > new.vehicle.radius + object.radius + extra + 0.3 + 0.06 * time.min(5.)\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn a_planned_stop_arms_retention_before_any_emergency_and_only_a_clear_candidate_releases_it() {\n    let mut p = planner(true);\n    let obj = growing(30., 0.);\n    assert_eq!(\n        p.plan(state(0., 8., 0.), &road(0.), &[obj.clone()]).mode,\n        DrivingMode::Yield\n    );\n    assert!(!p.holding_obstruction_stop());\n    let stopped = p.plan(state(20., 0., 0.), &road(0.), &[obj.clone()]);\n    assert_eq!(stopped.mode, DrivingMode::Yield);\n    assert!(p.holding_obstruction_stop());\n    assert!(\n        stopped\n            .points\n            .iter()\n            .all(|q| q.speed == 0. && q.position == point(20., 0.))\n    );\n    p.reset_route_state();\n    assert!(p.holding_obstruction_stop());\n    let mut invalid = obj.clone();\n    invalid.additional_radius_m[1] = f64::NAN;\n    assert_eq!(\n        p.plan(state(20., 0., 0.), &road(0.), &[invalid]).mode,\n        DrivingMode::Emergency\n    );\n    assert!(p.holding_obstruction_stop());\n    let clear = p.plan(state(20., 0., 0.), &road(0.), &[]);\n    assert_eq!(clear.mode, DrivingMode::Cruise);\n    assert!(clear.points[1].speed > 0.);\n    assert!(!p.holding_obstruction_stop());\n}\n\n#[test]\nfn unreachable_braking_and_an_interior_hold_conflict_remain_emergencies() {\n    let mut p = planner(true);\n    assert_eq!(\n        p.plan(state(0., 8., 0.), &road(0.), &[growing(14., 0.)])\n            .mode,\n        DrivingMode::Emergency\n    );\n    let mut conflict = growing(30., 0.);\n    // Clear at both forecast endpoints, but no stopping point survives the peak.\n    conflict.additional_radius_m.fill(0.);\n    conflict.additional_radius_m[30] = 50.;\n    assert_eq!(\n        planner(true)\n            .plan(state(0., 0., 0.), &road(0.), &[conflict])\n            .mode,\n        DrivingMode::Emergency\n    );\n}\n\n#[test]\nfn search_without_stop_retention_is_inadmissible() {\n    let mut p = planner(true);\n    p.settle_obstruction_stops = false;\n    assert_eq!(\n        p.plan(state(0., 0., 0.), &road(0.), &[]).mode,\n        DrivingMode::Emergency\n    );\n}\n\n#[test]\nfn a_complete_clear_side_candidate_can_release_a_searched_stop() {\n    let mut p = planner(true);\n    p.plan(state(0., 8., 0.), &road(0.), &[growing(30., 0.)]);\n    p.plan(state(20., 0., 0.), &road(0.), &[growing(30., 0.)]);\n    assert!(p.holding_obstruction_stop());\n    let wide = Route::new(vec![point(0., 0.), point(100., 0.)], 5.5).unwrap();\n    let mut obj = growing(30., 0.);\n    obj.additional_radius_m.clear();\n    let escape = p.plan(state(20., 0., 0.), &wide, &[obj]);\n    assert_ne!(escape.mode, DrivingMode::Emergency);\n    assert!(escape.lateral_target.abs() > 0.1);\n    assert!(escape.points.last().unwrap().speed > 0.);\n    assert!(!p.holding_obstruction_stop());\n}\n","scripts/check_stop_search.py":"#!/usr/bin/env python3\n\"\"\"Freeze earlier-stop search trials without waiving goal or forecast failures.\"\"\"\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nimport math\nfrom pathlib import Path\n\nfrom check_absolute_heading import audit as heading_audit, materialize as heading_input\nfrom check_forecast_envelope import audit as forecast_audit\nfrom check_gnss_map_history import sha\nfrom check_obstruction_stops import certify_trajectory, materialize as obstruction_input\nfrom check_relocalization_map_only import freeze as freeze_inputs, run_case\nfrom check_road_width import (GATES as ROAD_GATES, materialize as road_input,\n    projector, road_margin, swept_clearance, validate_inputs)\n\nREPO = Path(__file__).resolve().parents[1]\nGATES = dict(ROAD_GATES, minimum_emergency_step_reduction=.8,\n             mission_hold_window_s=[20., 65.], maximum_actual_hold_speed_m_s=.05,\n             maximum_extra_profiles_per_lateral_candidate=16,\n             parent_heading_results_sha256=sha(REPO/'assets/absolute-heading-results.json'),\n             parent_obstruction_results_sha256=sha(REPO/'assets/obstruction-stop-results.json'))\n\n\ndef specifications(plants):\n    rows = []\n    for plant in plants:\n        for seed in [7, 42]:\n            for heading in [False, True]:\n                rows.append(dict(plant=plant, world='mission', seed=seed, heading=heading,\n                                 family='heading' if heading else 'road', kind='base'))\n            for world in ['straight', 'curve', 'right']:\n                rows.append(dict(plant=plant, world=world, seed=seed, heading=True, family='heading', kind='base'))\n            for world in ['blocked', 'release', 'release-fault']:\n                rows.append(dict(plant=plant, world=world, seed=seed, heading=False, family='obstruction', kind='base'))\n        for kind in ['missing', 'jump', 'recover-missing', 'recover-jump']:\n            rows.append(dict(plant=plant, world='straight', seed=171, heading=True, family='heading', kind=kind))\n    for row in rows:\n        row['mode'] = ('heading-' if row['heading'] else '') + (row['kind']+'-' if row['kind']!='base' else '') + 'search'\n    return rows\n\n\ndef materialize(spec):\n    if spec['family']=='heading': source, value = heading_input(spec)\n    elif spec['family']=='road': source, value = road_input(dict(spec, mode='fitted'))\n    elif spec['family']=='obstruction': source, value = obstruction_input(dict(spec, mode='envelope' if spec['world']=='blocked' else 'enabled', settle=True))\n    else: raise ValueError('unknown stop-search fixture family')\n    value['search_obstruction_stops'] = True\n    return source, value\n\n\ndef freeze(output, specs): return freeze_inputs(output, specs, factory=materialize, gates=GATES)\n\n\ndef contract(config, ticks):\n    \"\"\"Infer a pending stop from complete emitted geometry, not a planner latch.\n\n    A partial stopped prefix arms retention before any emergency. Actual future\n    motion appears only in the separate physical scorer. A full clear candidate\n    releases the inferred duty; missing sensing and malformed holds cannot do so.\n    \"\"\"\n    locate = projector(config['route']['points']); length = config['route']['lengths'][-1]\n    armed = False; settled = False; arms = []; releases = []; held = 0; violations = []; bounds = 0\n    for tick in ticks:\n        out = tick['expected']; now = out['time']; path = out['trajectory']['points']\n        if not all(math.isfinite(out['command'][k]) for k in ['acceleration','steering']):\n            raise ValueError('nonfinite stop-search command')\n        if out['health']:\n            if out['command']['acceleration'] > -5.99: violations.append(dict(time=now, reason='health_fault_brake'))\n            continue\n        if out['trajectory']['mode']=='Emergency':\n            if path or out['command']['acceleration']>-5.99 or out['command']['steering']!=0.:\n                violations.append(dict(time=now, reason='emergency_brake'))\n            if out['predictions'] and not armed: armed=True; arms.append(now)\n            settled = settled or (armed and out['estimate']['speed']<=.2)\n            continue\n        if len(path)<2: raise ValueError('stop-search trajectory lacks a complete interval')\n        here = locate(out['estimate']['pose']['position'])[1]\n        span = locate(path[-1]['position'])[1]-here\n        complete = span >= min(40., max(0., length-here-1.))-.25\n        if complete:\n            if armed:\n                bounds += certify_trajectory(out,config['vehicle']['radius'])['interval_bounds']\n                armed=False; settled=False; releases.append(now)\n            continue\n        if path[-1]['speed']!=0. or abs(path[-1]['time']-path[-2]['time']-8.)>1e-8:\n            violations.append(dict(time=now, reason='partial_candidate_without_complete_stop_hold'))\n        if out['predictions'] and not armed: armed=True; arms.append(now)\n        if not armed: continue\n        # Validate every partial candidate, including each retained hold, with\n        # accelerated-path interval bounds independent of the Rust chord sweep.\n        bounds += certify_trajectory(out,config['vehicle']['radius'])['interval_bounds']\n        settled = settled or out['estimate']['speed']<=.2\n        if not settled: continue\n        held += 1\n        if (out['command']['acceleration']>-.5+1e-8\n                or any(b['speed']>a['speed']+1e-9 for a,b in zip(path,path[1:]))):\n            violations.append(dict(time=now, reason='restarted_on_partial_stop'))\n    return dict(passed=not violations, arms=arms, releases=releases, held_ticks=held,\n                violations=violations, certified_interval_bounds=bounds)\n\n\ndef audit(run, config, ticks, spec, frozen):\n    if config.get('search_obstruction_stops',False)!=frozen.get('search_obstruction_stops',False):\n        raise ValueError('stop-search replay policy differs from the frozen input')\n    if not config.get('settle_obstruction_stops'): raise ValueError('stop-search retention missing')\n    if spec['heading']:\n        result = heading_audit(run, config, ticks, spec, frozen)\n    else:\n        result = forecast_audit(run, config, ticks, spec, frozen)\n        result['road_containment'] = road_margin(run)\n        result['independent_clearance'] = swept_clearance(run)\n        if (result['road_containment']['minimum_actual_road_margin_m']<.1\n                or result['independent_clearance']['minimum_swept_clearance_m']<1.):\n            result['failed_gates'].append('physical_separation_road_reserve')\n    duty = contract(config, ticks)\n    result['stop_contract'] = duty\n    if not duty['passed']: result['failed_gates'].append('settled_stop_contract')\n    emergency = sum(bool(t['expected']['emergency']) for t in ticks)\n    if emergency != run['summary']['emergency_steps']: raise ValueError('emergency counter differs from complete outputs')\n    result['verified_emergency_steps'] = emergency\n    if spec['world']=='mission':\n        samples = [f for f in run['frames'] if 20.-1e-9<=f['time']<=65.+1e-9]\n        result['mission_hold'] = dict(samples=len(samples), maximum_actual_speed_m_s=max(f['truth']['speed'] for f in samples),\n                                     positive_control_commands=sum(f['command']['acceleration']>-.5+1e-8 for f in samples))\n    elif spec['family']=='obstruction':\n        lo, hi = (14.,20.) if spec['world']=='blocked' else (10.,11.5)\n        maximum = max(f['truth']['speed'] for f in run['frames'] if lo-1e-9<=f['time']<=hi+1e-9)\n        result['actual_hold_maximum_m_s'] = maximum\n        if maximum>.05: result['failed_gates'].append('actual_standstill')\n        if spec['world']!='blocked':\n            release = next((t['expected']['time'] for t in ticks if t['expected']['time']>=12. and t['expected']['command']['acceleration']>0.),None)\n            result['release_command_s'] = release\n            if release is None or release>22. or not run['summary']['reached_goal']: result['failed_gates'].append('clear_path_release_goal')\n        if spec['world']=='release-fault':\n            maximum = max(f['truth']['speed'] for f in run['frames'] if 13.5-1e-9<=f['time']<=14.95+1e-9)\n            result['fault_hold_maximum_m_s'] = maximum\n            if maximum>.05: result['failed_gates'].append('fault_standstill')\n    return result\n\n\ndef key(row): return tuple(row[k] for k in ['plant','world','seed','heading','kind'])\n\n\ndef compare(row, baseline):\n    verified = (not row.get('audit_error') and row.get('replay_exit_code')==0\n                and row.get('run_exit_code')==(0 if row.get('summary',{}).get('passed') else 1)\n                and row.get('replay',{}).get('verified') is True\n                and row['replay']['ticks']==row['summary']['steps'])\n    new = sorted(set(row.get('failed_gates',[]))-set(baseline['failed_gates']))\n    regression = verified and not new\n    stable = None\n    if row['world']=='mission':\n        hold = row.get('mission_hold',{})\n        stable = (verified and row.get('stop_contract',{}).get('passed') is True\n                  and row.get('verified_emergency_steps',math.inf)<=.2*baseline['verified_emergency_steps']\n                  and hold.get('samples',0)>=900 and hold.get('maximum_actual_speed_m_s',math.inf)<=.05\n                  and hold.get('positive_control_commands',1)==0)\n    return dict(regression_passed=regression, new_failed_gates=new, stable_mission_stop_passed=stable,\n                baseline_emergency_steps=baseline['verified_emergency_steps'],\n                baseline_failed_gates=baseline['failed_gates'])\n\n\ndef main():\n    parser=argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--output',type=Path,required=True)\n    parser.add_argument('--plant',choices=['all','reference-2d','rne-dynamic'],default='all')\n    parser.add_argument('--freeze-only',action='store_true')\n    parser.add_argument('--check-regression',action='store_true')\n    parser.add_argument('--baseline-results',type=Path,default=REPO/'assets/stop-search-results.json')\n    parser.add_argument('--binary',type=Path,default=REPO/'target/release/rustdriving')\n    parser.add_argument('--native-binary',type=Path,default=REPO/'integrations/rne/target/release/rustdriving-rne')\n    args=parser.parse_args(); output=args.output.resolve()\n    plants=['reference-2d','rne-dynamic'] if args.plant=='all' else [args.plant]\n    manifest=freeze(output,specifications(plants))\n    if args.freeze_only:return\n    baseline={key(r):r for r in json.loads(args.baseline_results.read_text())['baselines']}\n    binaries={'reference-2d':args.binary.resolve(),'rne-dynamic':args.native_binary.resolve()}\n    fingerprints={k:sha(binaries[k]) for k in plants};validate_inputs(output,manifest,args.binary.resolve());rows=[]\n    def one(spec):\n        folder=output/'episodes'/spec['plant']/f\"{spec['world']}-{spec['mode']}-seed-{spec['seed']}\"\n        return run_case(output,spec,binaries[spec['plant']],args.binary.resolve(),auditor=lambda r,c,t,s,f:audit(r,c,t,dict(s,_folder=str(folder)),f))\n    with ThreadPoolExecutor(max_workers=2) as pool:\n        for row in pool.map(one,manifest['episodes']):\n            row['comparison']=compare(row,baseline[key(row)]);rows.append(row)\n            report=dict(complete=len(rows)==len(manifest['episodes']),binaries=fingerprints,\n                        manifest_sha256=sha(output/'frozen-manifest.json'),episodes=rows)\n            (output/'report.json').write_text(json.dumps(report,indent=2)+'\\n')\n            print(row['plant'],row['world'],row['mode'],row['seed'],row['comparison'],row.get('audit_error'),flush=True)\n    report.update(regression_passed=all(r['comparison']['regression_passed'] for r in rows),\n                  stable_mission_stops_passed=all(r['comparison']['stable_mission_stop_passed'] for r in rows if r['world']=='mission'),\n                  strict_qualification_passed=all(r['passed'] for r in rows))\n    (output/'report.json').write_text(json.dumps(report,indent=2)+'\\n')\n    assert all(sha(binaries[k])==fingerprints[k] for k in plants)\n    if not (report['regression_passed'] and report['stable_mission_stops_passed'] if args.check_regression else report['strict_qualification_passed']):raise SystemExit(1)\n\n\nif __name__=='__main__':main()\n","scripts/test_stop_search.py":"#!/usr/bin/env python3\n\"\"\"Adversarial retention, comparison and frozen-world checks for stop search.\"\"\"\nimport copy\nfrom pathlib import Path\nimport tempfile\nimport unittest\n\nfrom check_stop_search import compare, contract, freeze, materialize, specifications\nfrom check_absolute_heading import materialize as heading_input\nfrom check_obstruction_stops import materialize as obstruction_input\nfrom check_road_width import materialize as road_input\nfrom test_obstruction_stops import config, output as original_output, sample, ticks\n\n\ndef output(*args, **kwargs):\n    value=original_output(*args, **kwargs)\n    value['command']['steering']=0.\n    r