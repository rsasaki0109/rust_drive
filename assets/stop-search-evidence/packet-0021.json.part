\n     /// None preserves the original fixed +/-3.5 m offsets.\n     pub lateral_candidate_margin_m: Option<f64>,\n@@ -39,6 +43,14 @@ pub struct LatticePlanner {\n     terminal_side_reserved: bool,\n     obstruction_stop_requested: bool,\n     obstruction_stop_active: bool,\n+    searched_stop_s: Option<f64>,\n+}\n+struct Selection {\n+    cost: (bool, bool, f64),\n+    trajectory: Trajectory,\n+    blocked: bool,\n+    searched: bool,\n+    stop_s: Option<f64>,\n }\n impl Default for LatticePlanner {\n     fn default() -> Self {\n@@ -49,6 +61,7 @@ impl Default for LatticePlanner {\n             point_reference_recovery: false,\n             terminal_settling: true,\n             settle_obstruction_stops: false,\n+            search_obstruction_stops: false,\n             lateral_candidate_margin_m: None,\n             vehicle: VehicleConfig::default(),\n             max_acceleration_m_s2: 2.0,\n@@ -60,6 +73,7 @@ impl Default for LatticePlanner {\n             terminal_side_reserved: false,\n             obstruction_stop_requested: false,\n             obstruction_stop_active: false,\n+            searched_stop_s: None,\n         }\n     }\n }\n@@ -71,11 +85,15 @@ impl LatticePlanner {\n         self.maneuver_start = None;\n         self.yield_stop_s = None;\n         self.terminal_side_reserved = false;\n+        self.searched_stop_s = None;\n     }\n \n     pub fn holding_obstruction_stop(&self) -> bool {\n         self.settle_obstruction_stops && self.obstruction_stop_active\n     }\n+    pub fn braking_obstruction_stop(&self) -> bool {\n+        self.search_obstruction_stops && self.obstruction_stop_requested\n+    }\n }\n impl Planner for LatticePlanner {\n     fn plan(&mut self, ego: EgoState, route: &Route, objects: &[Prediction]) -> Trajectory {\n@@ -84,6 +102,7 @@ impl Planner for LatticePlanner {\n             || !ego.pose.yaw.is_finite()\n             || !self.cruise_speed.is_finite()\n             || self.cruise_speed <= 0.0\n+            || (self.search_obstruction_stops && !self.settle_obstruction_stops)\n             || !self.max_acceleration_m_s2.is_finite()\n             || self.max_acceleration_m_s2 <= 0.0\n             || !self.max_deceleration_m_s2.is_finite()\n@@ -172,8 +191,11 @@ impl Planner for LatticePlanner {\n         let hold_requested = self.settle_obstruction_stops\n             && (self.obstruction_stop_active\n                 || (self.obstruction_stop_requested && ego.speed <= 0.2));\n+        // A searched alternative is a commitment to brake, including before\n+        // reaching standstill. Ordinary blocked approaches retain their prior\n+        // behavior until a search or collision emergency actually requests it.\n         let mut collision_seen = false;\n-        let mut best: Option<((bool, bool, f64), Trajectory, bool)> = None;\n+        let mut best: Option<Selection> = None;\n         let side = self.lateral_candidate_margin_m.map_or(3.5, |margin| {\n             (route.half_width - self.vehicle.radius - margin).clamp(0.0, 3.5)\n         });\n@@ -329,9 +351,10 @@ impl Planner for LatticePlanner {\n             };\n             let first_contact = contact(&points);\n             let blocked = first_contact.is_finite();\n+            let mut searched = false;\n             if blocked {\n                 collision_seen = true;\n-                let stop = if hold_requested {\n+                let mut stop = if hold_requested {\n                     let speed = ego.speed.max(0.0);\n                     if speed == 0.0 {\n                         0.0\n@@ -347,25 +370,40 @@ impl Planner for LatticePlanner {\n                 } else {\n                     (speed::distance_at(&points, first_contact) - 4.0).max(0.0)\n                 };\n+                if self.braking_obstruction_stop() && !hold_requested {\n+                    stop = self.searched_stop_s.map_or_else(\n+                        || ego.speed.max(0.0).powi(2) / (2.0 * self.max_deceleration_m_s2),\n+                        |anchor| {\n+                            stop.min(stopping::distance_at_progress(\n+                                &geometry,\n+                                horizon,\n+                                anchor - s,\n+                            ))\n+                        },\n+                    );\n+                }\n                 let stopping_limits = speed::Limits {\n                     cruise: if hold_requested {\n                         0.0\n+                    } else if self.braking_obstruction_stop() {\n+                        candidate_limits.cruise.min(ego.speed.max(0.0))\n                     } else {\n                         candidate_limits.cruise\n                     },\n                     ..candidate_limits\n                 };\n-                let Some(stopped) =\n-                    speed::profile(&geometry, ego.speed.max(0.0), &stopping_limits, Some(stop))\n-                else {\n+                let Some((stopped, used_search)) = stopping::profile(\n+                    &geometry,\n+                    ego.speed.max(0.0),\n+                    &stopping_limits,\n+                    stop,\n+                    self.search_obstruction_stops && !hold_requested,\n+                    |path| !contact(path).is_finite(),\n+                ) else {\n                     continue;\n                 };\n                 points = stopped;\n-                // Slowing changes arrival times. Revalidate the complete braking path,\n-                // including an eight-second stationary hold; reject unsafe retiming.\n-                if contact(&points).is_finite() {\n-                    continue;\n-                }\n+                searched = used_search && ego.speed > 0.2;\n             }\n             let permitted = points.iter().map(|p| p.speed).fold(0.0_f64, f64::max);\n             let switching_penalty = if target * self.previous_lateral < 0.0 {\n@@ -427,34 +465,66 @@ impl Planner for LatticePlanner {\n                 mode,\n                 lateral_target: target,\n             };\n+            let stop_s = (self.search_obstruction_stops && blocked).then(|| {\n+                let distance = traj\n+                    .points\n+                    .windows(2)\n+                    .map(|p| p[0].position.distance(p[1].position))\n+                    .sum();\n+                s + stopping::progress_at_distance(&geometry, horizon, distance)\n+            });\n             // Prefer an already settled stopping place when its complete hold\n             // is feasible. Speed rewards must not restart a completed maneuver.\n             // A genuinely unblocked route can release the stop, including a\n             // safe lateral escape. A retimed approach to the same obstruction\n             // cannot restart a completed emergency stop for a speed reward.\n             let cost = (hold_requested && blocked, !settling_goal, score);\n-            if best\n-                .as_ref()\n-                .is_none_or(|(previous, _, _)| cost < *previous)\n-            {\n-                best = Some((cost, traj, blocked));\n+            if best.as_ref().is_none_or(|previous| cost < previous.cost) {\n+                best = Some(Selection {\n+                    cost,\n+                    trajectory: traj,\n+                    blocked,\n+                    searched,\n+                    stop_s,\n+                });\n             }\n         }\n-        let (blocked, trajectory) = best.map(|(_, t, blocked)| (blocked, t)).unwrap_or((\n-            false,\n-            Trajectory {\n-                points: vec![],\n-                mode: DrivingMode::Emergency,\n-                lateral_target: 0.0,\n-            },\n-        ));\n+        let (blocked, searched, stop_s, trajectory) = best\n+            .map(|choice| {\n+                (\n+                    choice.blocked,\n+                    choice.searched,\n+                    choice.stop_s,\n+                    choice.trajectory,\n+                )\n+            })\n+            .unwrap_or((\n+                false,\n+                false,\n+                None,\n+                Trajectory {\n+                    points: vec![],\n+                    mode: DrivingMode::Emergency,\n+                    lateral_target: 0.0,\n+                },\n+            ));\n         self.obstruction_stop_requested = self.settle_obstruction_stops\n             && if trajectory.mode == DrivingMode::Emergency {\n                 self.obstruction_stop_requested || collision_seen\n             } else {\n-                self.obstruction_stop_requested && blocked\n+                blocked && (searched || self.obstruction_stop_requested)\n             };\n         self.obstruction_stop_active = self.obstruction_stop_requested && hold_requested;\n+        if self.search_obstruction_stops {\n+            self.searched_stop_s = if !self.obstruction_stop_requested {\n+                None\n+            } else {\n+                match (self.searched_stop_s, stop_s) {\n+                    (Some(old), Some(new)) => Some(old.min(new)),\n+                    (old, new) => old.or(new),\n+                }\n+            };\n+        }\n         if trajectory.mode != DrivingMode::Emergency {\n             if terminal_traffic && trajectory.lateral_target.abs() > 0.1 {\n                 // Keep the stopping-place preference through forecast jitter,\ndiff --git a/crates/sim/src/lib.rs b/crates/sim/src/lib.rs\nindex 7f4f04e..ab1f3d3 100644\n--- a/crates/sim/src/lib.rs\n+++ b/crates/sim/src/lib.rs\n@@ -139,6 +139,8 @@ pub struct Scenario {\n     pub forecast_envelope: Option<rustdriving_core::ForecastEnvelopeConfig>,\n     #[serde(default, skip_serializing_if = \"is_false\")]\n     pub settle_obstruction_stops: bool,\n+    #[serde(default, skip_serializing_if = \"is_false\")]\n+    pub search_obstruction_stops: bool,\n     #[serde(default, skip_serializing_if = \"Option::is_none\")]\n     pub lateral_candidate_margin_m: Option<f64>,\n     /// Evaluation recording only; omitted from the operational replay header.\n@@ -740,6 +742,7 @@ pub fn pipeline_config(scenario: &Scenario) -> PipelineConfig {\n     config.confirm_slow_motion = scenario.confirm_slow_motion;\n     config.forecast_envelope = scenario.forecast_envelope;\n     config.settle_obstruction_stops = scenario.settle_obstruction_stops;\n+    config.search_obstruction_stops = scenario.search_obstruction_stops;\n     config.lateral_candidate_margin_m = scenario.lateral_candidate_margin_m;\n     config.gnss_latency_compensation = scenario.gnss_latency_compensation;\n     config.speed_zones = scenario.speed_zones.clone();\ndiff --git a/scripts/check.sh b/scripts/check.sh\nindex 4c5edba..df5d7e4 100755\n--- a/scripts/check.sh\n+++ b/scripts/check.sh\n@@ -5,6 +5,7 @@ source scripts/env.sh\n python3 scripts/test_prediction_evidence.py\n python3 scripts/test_forecast_envelope.py\n python3 scripts/test_obstruction_stops.py\n+python3 scripts/test_stop_search.py\n python3 scripts/test_road_width.py\n python3 scripts/test_absolute_heading.py\n python3 scripts/test_lane_occupancy.py\n","new_file_contents":{"crates/planning/src/stopping.rs":"//! Bounded alternatives to a rejected collision-retimed stopping position.\nuse crate::speed::{self, Limits};\nuse rustdriving_core::{TrajectoryPoint, Vec2};\n\n/// Preserve the ordinary proposal first. Every alternative rebuilds the actual\n/// reachable speed profile and sweeps its braking segments and eight-second\n/// stationary tail. Moving traffic makes feasibility non-monotonic in distance;\n/// no binary-search or endpoint-only clearance assumption is used.\npub(super) fn profile(\n    geometry: &[Vec2],\n    initial_speed: f64,\n    limits: &Limits<'_>,\n    proposed_stop: f64,\n    search: bool,\n    mut clear: impl FnMut(&[TrajectoryPoint]) -> bool,\n) -> Option<(Vec<TrajectoryPoint>, bool)> {\n    if let Some(path) = speed::profile(geometry, initial_speed, limits, Some(proposed_stop))\n        && clear(&path)\n    {\n        return Some((path, false));\n    }\n    if !search {\n        return None;\n    }\n    // Round slightly outward at positive speeds so the braking endpoint is\n    // representable without an instantaneous speed clamp. Never extend the\n    // original stopping proposal or change the supplied braking authority.\n    let minimum = if initial_speed == 0.0 {\n        0.0\n    } else {\n        (initial_speed.powi(2) / (2.0 * limits.deceleration) * (1.0 + 1e-12)).max(1e-7)\n    };\n    if !minimum.is_finite() || minimum >= proposed_stop {\n        return None;\n    }\n    // Reuse the existing four-meter stopping heuristic after rejected retiming.\n    // It proposes locations; only the unchanged complete sweep decides safety.\n    let upper = (proposed_stop - 4.0).max(minimum);\n    let fallback = Limits {\n        zones: limits.zones,\n        acceleration: limits.acceleration,\n        deceleration: limits.deceleration,\n        lateral: limits.lateral,\n        cruise: if initial_speed > 0.2 {\n            limits.cruise.min(initial_speed)\n        } else {\n            limits.cruise\n        },\n    };\n    for index in 0..if upper == minimum { 1 } else { 16 } {\n        let stop = upper + (minimum - upper) * index as f64 / 15.0;\n        if let Some(path) = speed::profile(geometry, initial_speed, &fallback, Some(stop))\n            && clear(&path)\n        {\n            return Some((path, true));\n        }\n    }\n    None\n}\n\n/// Knots are uniform in route progress, rather than in actual candidate arc.\npub(super) fn distance_at_progress(geometry: &[Vec2], horizon: f64, progress: f64) -> f64 {\n    if horizon <= 0.0 {\n        return 0.0;\n    }\n    let step =\n        (progress / horizon * (geometry.len() - 1) as f64).clamp(0.0, (geometry.len() - 1) as f64);\n    geometry\n        .windows(2)\n        .enumerate()\n        .map(|(i, p)| p[0].distance(p[1]) * (step - i as f64).clamp(0.0, 1.0))\n        .sum()\n}\n\npub(super) fn progress_at_distance(geometry: &[Vec2], horizon: f64, mut distance: f64) -> f64 {\n    for (index, pair) in geometry.windows(2).enumerate() {\n        let length = pair[0].distance(pair[1]);\n        if distance <= length && length > 0.0 {\n            return horizon * (index as f64 + distance / length) / (geometry.len() - 1) as f64;\n        }\n        distance -= length;\n    }\n    horizon\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_nonuniform_corrected_path_preserves_the_original_progress_anchor() {\n        let geometry = [\n            Vec2::default(),\n            Vec2::new(3., 0.),\n            Vec2::new(3., 4.),\n            Vec2::new(9., 4.),\n        ];\n        assert_eq!(distance_at_progress(&geometry, 30., 15.), 5.);\n        assert_eq!(progress_at_distance(&geometry, 30., 5.), 15.);\n        assert_eq!(distance_at_progress(&geometry, 30., -1.), 0.);\n        assert_eq!(distance_at_progress(&geometry, 30., 100.), 13.);\n        for i in 0..=300 {\n            let progress = i as f64 * 0.1;\n            let roundtrip = progress_at_distance(\n                &geometry,\n                30.,\n                distance_at_progress(&geometry, 30., progress),\n            );\n            assert!((roundtrip - progress).abs() < 1e-12);\n        }\n    }\n\n    #[test]\n    fn exhaustive_rejection_cannot_exceed_seventeen_complete_sweeps() {\n        let geometry: Vec<_> = (0..=80).map(|i| Vec2::new(i as f64 * 0.5, 0.)).collect();\n        let limits = Limits {\n            zones: None,\n            acceleration: 2.,\n            deceleration: 2.5,\n            lateral: None,\n            cruise: 8.,\n        };\n        let mut calls = 0;\n        assert!(\n            profile(&geometry, 2., &limits, 30., true, |_| {\n                calls += 1;\n                false\n            })\n            .is_none()\n        );\n        assert_eq!(calls, 17);\n    }\n}\n","crates/planning/tests/stop_search.rs":"use rustdriving_core::{DrivingMode, EgoState, Planner, Pose, Prediction, Route, Vec2};\nuse rustdriving_planning::LatticePlanner;\n\nfn point(x: f64, yaw: f64) -> Vec2 {\n    Vec2::new(x, 0.).rotated(yaw).plus(Vec2::new(12., -7.))\n}\nfn state(x: f64, speed: f64, yaw: f64) -> EgoState {\n    EgoState {\n        pose: Pose {\n            position: point(x, yaw),\n            yaw,\n        },\n        speed,\n    }\n}\nfn road(yaw: f64) -> Route {\n    Route::new(vec![point(0., yaw), point(100., yaw)], 2.1).unwrap()\n}\nfn growing(x: f64, yaw: f64) -> Prediction {\n    Prediction {\n        id: 1,\n        positions: vec![point(x, yaw); 41],\n        radius: 1.,\n        dt: 0.2,\n        additional_radius_m: (0..=40)\n            .map(|i| {\n                let t = i as f64 * 0.2;\n                0.2 + 0.3 * t + 0.05 * t * t\n            })\n            .collect(),\n    }\n}\nfn planner(search: bool) -> LatticePlanner {\n    let mut p = LatticePlanner::default();\n    p.settle_obstruction_stops = true;\n    p.search_obstruction_stops = search;\n    p\n}\n\n#[test]\nfn an_earlier_stop_repairs_retiming_without_changing_the_forecast_or_braking_authority() {\n    for yaw in [0., 0.7, -1.9] {\n        let object = growing(30., yaw);\n        let mut old = planner(false);\n        assert_eq!(\n            old.plan(\n                state(0., 8., yaw),\n                &road(yaw),\n                std::slice::from_ref(&object)\n            )\n            .mode,\n            DrivingMode::Emergency\n        );\n        let mut new = planner(true);\n        let p = new.plan(\n            state(0., 8., yaw),\n            &road(yaw),\n            std::slice::from_ref(&object),\n        );\n        assert_eq!(p.mode, DrivingMode::Yield);\n        assert_eq!(p.points[0].speed, 8.);\n        let tail = &p.points[p.points.len() - 2..];\n        assert_eq!(tail[0].speed, 0.);\n        assert_eq!(tail[0].position, tail[1].position);\n        assert!((tail[1].time - tail[0].time - 8.).abs() < 1e-12);\n        // Independent 1 ms integration of constant acceleration, including the\n        // entire hold and every growing-radius interval, rather than chord tests.\n        for pair in p.points.windows(2) {\n            let a = pair[0];\n            let b = pair[1];\n            let dt = b.time - a.time;\n            let acceleration = (b.speed - a.speed) / dt;\n            assert!((-2.5 - 1e-9..=2.0 + 1e-9).contains(&acceleration));\n            let length = a.position.distance(b.position);\n            assert!((length - (a.speed + b.speed) * dt * 0.5).abs() < 1e-9);\n            for i in 0..=(dt * 1000.).ceil() as usize {\n                let elapsed = (i as f64 * 0.001).min(dt);\n                let time = a.time + elapsed;\n                let fraction = if length > 1e-10 {\n                    (a.speed * elapsed + 0.5 * acceleration * elapsed * elapsed) / length\n                } else {\n                    0.\n                };\n                let position = a\n                    .position\n                    .plus(b.position.minus(a.position).scaled(fraction));\n                let step = (time / 0.2).min(40.);\n                let index = step.floor() as usize;\n                let next = (index + 1).min(40);\n                let extra = object.additional_radius_m[index]\n                    + (object.additional_radius_m[next] - object.additional_radius_m[index])\n                        * (step - index as f64);\n                assert!(\n                    position.distance(object.positions[0])\n                        > new.vehicle.radius + object.radius + extra + 0.3 + 0.06 * time.min(5.)\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn a_planned_stop_arms_retention_before_any_emergency_and_only_a_clear_candidate_releases_it() {\n    let mut p = planner(true);\n    let obj = growing(30., 0.);\n    assert_eq!(\n        p.plan(state(0., 8., 0.), &road(0.), std::slice::from_ref(&obj))\n            .mode,\n        DrivingMode::Yield\n    );\n    assert!(!p.holding_obstruction_stop());\n    let anchor = p.plan(state(4., 6., 0.), &road(0.), std::slice::from_ref(&obj));\n    assert_eq!(anchor.mode, DrivingMode::Yield);\n    assert!(p.braking_obstruction_stop());\n    let moving = p.plan(state(8., 4., 0.), &road(0.), std::slice::from_ref(&obj));\n    assert_eq!(moving.mode, DrivingMode::Yield);\n    assert_eq!(moving.points[0].speed, 4.);\n    assert!(\n        moving\n            .points\n            .windows(2)\n            .all(|pair| pair[1].speed <= pair[0].speed)\n    );\n    assert!(\n        moving.points.last().unwrap().position.x <= anchor.points.last().unwrap().position.x + 1e-8\n    );\n    let stopped = p.plan(state(20., 0., 0.), &road(0.), std::slice::from_ref(&obj));\n    assert_eq!(stopped.mode, DrivingMode::Yield);\n    assert!(p.holding_obstruction_stop());\n    assert!(\n        stopped\n            .points\n            .iter()\n            .all(|q| q.speed == 0. && q.position == point(20., 0.))\n    );\n    p.reset_route_state();\n    assert!(p.holding_obstruction_stop());\n    let mut invalid = obj.clone();\n    invalid.additional_radius_m[1] = f64::NAN;\n    assert_eq!(\n        p.plan(state(20., 0., 0.), &road(0.), &[invalid]).mode,\n        DrivingMode::Emergency\n    );\n    assert!(p.holding_obstruction_stop());\n    let clear = p.plan(state(20., 0., 0.), &road(0.), &[]);\n    assert_eq!(clear.mode, DrivingMode::Cruise);\n    assert!(clear.points[1].speed > 0.);\n    assert!(!p.holding_obstruction_stop());\n}\n\n#[test]\nfn an_ordinary_safe_approach_from_rest_does_not_arm_a_searched_stop() {\n    let mut p = planner(true);\n    let obj = growing(35., 0.);\n    for _ in 0..3 {\n        let approach = p.plan(state(0., 0., 0.), &road(0.), std::slice::from_ref(&obj));\n        assert_eq!(approach.mode, DrivingMode::Yield);\n        assert!(approach.points[1].speed > 0.);\n        assert!(!p.holding_obstruction_stop());\n    }\n}\n\n#[test]\nfn unreachable_braking_and_an_interior_hold_conflict_remain_emergencies() {\n    let mut p = planner(true);\n    assert_eq!(\n        p.plan(state(0., 8., 0.), &road(0.), &[growing(14., 0.)])\n            .mode,\n        DrivingMode::Emergency\n    );\n    let mut conflict = growing(30., 0.);\n    // Clear at both forecast endpoints, but no stopping point survives the peak.\n    conflict.additional_radius_m.fill(0.);\n    conflict.additional_radius_m[30] = 50.;\n    assert_eq!(\n        planner(true)\n            .plan(state(0., 0., 0.), &road(0.), &[conflict])\n            .mode,\n        DrivingMode::Emergency\n    );\n}\n\n#[test]\nfn search_without_stop_retention_is_inadmissible() {\n    let mut p = planner(true);\n    p.settle_obstruction_stops = false;\n    assert_eq!(\n        p.plan(state(0., 0., 0.), &road(0.), &[]).mode,\n        DrivingMode::Emergency\n    );\n}\n\n#[test]\nfn a_complete_clear_side_candidate_can_release_a_searched_stop() {\n    let mut p = planner(true);\n    p.plan(state(0., 8., 0.), &road(0.), &[growing(30., 0.)]);\n    p.plan(state(20., 0., 0.), &road(0.), &[growing(30., 0.)]);\n    assert!(p.holding_obstruction_stop());\n    let wide = Route::new(vec![point(0., 0.), point(100., 0.)], 5.5).unwrap();\n    let mut obj = growing(30., 0.);\n    obj.additional_radius_m.clear();\n    let escape = p.plan(state(20., 0., 0.), &wide, &[obj]);\n    assert_ne!(escape.mode, DrivingMode::Emergency);\n    assert!(escape.lateral_target.abs() > 0.1);\n    assert!(escape.points.last().unwrap().speed > 0.);\n    assert!(!p.holding_obstruction_stop());\n}\n","crates/sim/tests/stop_search.rs":"use rustdriving_sim::{Scenario, pipeline_config};\n\n#[test]\nfn scenario_validation_and_operational_header_retain_the_stop_search_policy() {\n    let mut s: Scenario =\n        serde_json::from_str(include_str!(\"../../../scenarios/mission.json\")).unwrap();\n    assert!(!s.search_obstruction_stops);\n    assert!(\n        serde_json::to_value(&s)\n            .unwrap()\n            .get(\"search_obstruction_stops\")\n            .is_none()\n    );\n    s.search_obstruction_stops = true;\n    assert!(s.validate().is_err());\n    s.settle_obstruction_stops = true;\n    assert!(s.validate().is_ok());\n    assert!(pipeline_config(&s).search_obstruction_stops);\n}\n","scripts/check_stop_search.py":"#!/usr/bin/env python3\n\"\"\"Freeze earlier-stop search trials without waiving goal or forecast failures.\"\"\"\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nimport math\nfrom pathlib import Path\n\nfrom check_absolute_heading import audit as heading_audit, materialize as heading_input\nfrom check_forecast_envelope import audit as forecast_audit\nfrom check_gnss_map_history import sha\nfrom check_obstruction_stops import certify_trajectory, materialize as obstruction_input\nfrom check_relocalization_map_only import freeze as freeze_inputs, run_case\nfrom check_road_width import (GATES as ROAD_GATES, materialize as road_input,\n    projector, road_margin, swept_clearance, validate_inputs)\n\nREPO = Path(__file__).resolve().parents[1]\nGATES = dict(ROAD_GATES, minimum_emergency_step_reduction=.8,\n             mission_hold_window_s=[20., 65.], maximum_actual_hold_speed_m_s=.05,\n             maximum_extra_profiles_per_lateral_candidate=16,\n             parent_heading_results_sha256=sha(REPO/'assets/absolute-heading-results.json'),\n             parent_obstruction_results_sha256=sha(REPO/'assets/obstruction-stop-results.json'))\n\n\ndef specifications(plants):\n    rows = []\n    for plant in plants:\n        for seed in [7, 42]:\n            for heading in [False, True]:\n                rows.append(dict(plant=plant, world='mission', seed=seed, heading=heading,\n                                 family='heading' if heading else 'road', kind='base'))\n            for world in ['straight', 'curve', 'right']:\n                rows.append(dict(plant=plant, world=world, seed=seed, heading=True, family='heading', kind='base'))\n            for world in ['blocked', 'release', 'release-fault']:\n                rows.append(dict(plant=plant, world=world, seed=seed, heading=False, family='obstruction', kind='base'))\n        for kind in ['missing', 'jump', 'recover-missing', 'recover-jump']:\n            rows.append(dict(plant=plant, world='straight', seed=171, heading=True, family='heading', kind=kind))\n    for row in rows:\n        row['mode'] = ('heading-' if row['heading'] else '') + (row['kind']+'-' if row['kind']!='base' else '') + 'search'\n    return rows\n\n\ndef materialize(spec):\n    if spec['family']=='heading': source, value = heading_input(spec)\n    elif spec['family']=='road': source, value = road_input(dict(spec, mode='fitted'))\n    elif spec['family']=='obstruction': source, value = obstruction_input(dict(spec, mode='envelope' if spec['world']=='blocked' else 'enabled', settle=True))\n    else: raise ValueError('unknown stop-search fixture family')\n    value['search_obstruction_stops'] = True\n    return source, value\n\n\ndef freeze(output, specs): return freeze_inputs(output, specs, factory=materialize, gates=GATES)\n\n\ndef contract(config, ticks):\n    \"\"\"Infer a pending stop from complete emitted geometry, not a planner latch.\n\n    A monotonic moving brake arms retention before any emergency. An ordinary\n    stopped launch on a partial approach does not. Actual future motion appears\n    only in the separate physical scorer. A full clear candidate releases the\n    inferred duty; missing sensing and malformed holds cannot do so.\n    \"\"\"\n    locate = projector(config['route']['points']); length = config['route']['lengths'][-1]\n    armed = False; settled = False; arms = []; releases = []; held = 0; violations = []; bounds = 0\n    for tick in ticks:\n        out = tick['expected']; now = out['time']; path = out['trajectory']['points']\n        if not all(math.isfinite(out['command'][k]) for k in ['acceleration','steering']):\n            raise ValueError('nonfinite stop-search command')\n        if out['health']:\n            if out['command']['acceleration'] > -5.99: violations.append(dict(time=now, reason='health_fault_brake'))\n            continue\n        if out['trajectory']['mode']=='Emergency':\n            if path or out['command']['acceleration']>-5.99 or out['command']['steering']!=0.:\n                violations.append(dict(time=now, reason='emergency_brake'))\n            if out['predictions'] and not armed: armed=True; arms.append(now)\n            settled = settled or (armed and out['estimate']['speed']<=.2)\n            continue\n        if len(path)<2: raise ValueError('stop-search trajectory lacks a complete interval')\n        here = locate(out['estimate']['pose']['position'])[1]\n        span = locate(path[-1]['position'])[1]-here\n        complete = span >= min(40., max(0., length-here-1.))-.25\n        if complete:\n            if armed:\n                bounds += certify_trajectory(out,config['vehicle']['radius'])['interval_bounds']\n                armed=False; settled=False; releases.append(now)\n            continue\n        if path[-1]['speed']!=0. or abs(path[-1]['time']-path[-2]['time']-8.)>1e-8:\n            violations.append(dict(time=now, reason='partial_candidate_without_complete_stop_hold'))\n        braking = (out['estimate']['speed']>.2\n                   and all(b['speed']<=a['speed']+1e-9 for a,b in zip(path,path[1:])))\n        if out['predictions'] and braking and not armed: armed=True; arms.append(now)\n        if not armed: continue\n        # Validate every partial candidate, including each retained hold, with\n        # accelerated-path interval bounds independent of the Rust chord sweep.\n        bounds += certify_trajectory(out,config['vehicle']['radius'])['interval_bounds']\n        settled = settled or out['estimate']['speed']<=.2\n        if not settled: continue\n        held += 1\n        if (out['command']['acceleration']>-.5+1e-8\n                or any(b['speed']>a['speed']+1e-9 for a,b in zip(path,path[1:]))):\n            violations.append(dict(time=now, reason='restarted_on_partial_stop'))\n    return dict(passed=not violations, arms=arms, releases=releases, held_ticks=held,\n                violations=violations, certified_interval_bounds=bounds)\n\n\ndef audit(run, config, ticks, spec, frozen):\n    if config.get('search_obstruction_stops',False)!=frozen.get('search_obstruction_stops',False):\n        raise ValueError('stop-search replay policy differs from the frozen input')\n    if not config.get('settle_obstruction_stops'): raise ValueError('stop-search retention missing')\n    if spec['heading']:\n        result = heading_audit(run, config, ticks, spec, frozen)\n    else:\n        result = forecast_audit(run, config, ticks, spec, frozen)\n        result['road_containment'] = road_margin(run)\n        result['independent_clearance'] = swept_clearance(run)\n        if (result['road_containment']['minimum_actual_road_margin_m']<.1\n                or result['independent_clearance']['minimum_swept_clearance_m']<1.):\n            result['failed_gates'].append('physical_separation_road_reserve')\n    duty = contract(config, ticks)\n    result['stop_contract'] = duty\n    if not duty['passed']: result['failed_gates'].append('settled_stop_contract')\n    emergency = sum(bool(t['expected']['emergency']) for t in ticks)\n    if emergency != run['summary']['emergency_steps']: raise ValueError('emergency counter differs from complete outputs')\n    result['verified_emergency_steps'] = emergency\n    if spec['world']=='mission':\n        samples = [f for f in run['frames'] if 20.-1e-9<=f['time']<=65.+1e-9]\n        result['mission_hold'] = dict(samples=len(samples), maximum_actual_speed_m_s=max(f['truth']['speed'] for f in samples),\n                                     positive_control_commands=sum(f['command']['acceleration']>-.5+1e-8 for f in samples))\n    elif spec['family']=='obstruction':\n        lo, hi = (14.,20.) if spec['world']=='blocked' els