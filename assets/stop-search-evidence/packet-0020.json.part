2ac05fe32dd7612c2b93bf09bc86e9c91ccaf679cd1d3940f88a47","scripts/test_road_width.py":"8ec20c0dd9bd5125578310afe2b7bbc2794fcf2d028a5c70e63c6a7b695e47db","scripts/test_signal_relocalization.py":"5c7a85f980c270229a80d5d0ebd943c35567446cc4c2d729ab23780243250367","scripts/test_speed_zones.py":"70e55b236786c33dbadb2c65a02ce95fea6c9e0d7fff1a050da4318796536b1a","scripts/test_stop_relocalization.py":"64073148da02d777ca7b662211e8e495169e382c6571b8592c0f967811d7dc23","scripts/test_yield_relocalization.py":"82f1a027ce0f859a4d664151aea0e6aa0af5104b3f8d62b6459ccafebc5c4b01","scripts/tracking_frame.py":"2dd53853aad6e4f46d6b5f88c1b86de61ac0152c8a3b5bdc108d24ab5eaf0b64"},"source_reconstruction":{"parent_patch":"diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 7c4195c..559327d 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -32,6 +32,8 @@ jobs:\n         run: python scripts/test_obstruction_stops.py\n       - name: Check road-width candidates and independent circular road containment\n         run: python scripts/test_road_width.py\n+      - name: Check certified earlier stops and retained goal/coverage failures\n+        run: python scripts/test_stop_search.py\n       - name: Check absolute heading covariance and frozen acquisition protocol\n         run: python scripts/test_absolute_heading.py\n       - name: Check contained lane-conflict witnesses\ndiff --git a/crates/pipeline/src/lib.rs b/crates/pipeline/src/lib.rs\nindex 034001b..0f4d5cd 100644\n--- a/crates/pipeline/src/lib.rs\n+++ b/crates/pipeline/src/lib.rs\n@@ -103,6 +103,9 @@ pub struct PipelineConfig {\n     pub forecast_envelope: Option<ForecastEnvelopeConfig>,\n     #[serde(default, skip_serializing_if = \"is_false\")]\n     pub settle_obstruction_stops: bool,\n+    /// Search earlier collision-safe stopping positions and retain their hold.\n+    #[serde(default, skip_serializing_if = \"is_false\")]\n+    pub search_obstruction_stops: bool,\n     /// Optional extra road-edge reserve for width-fitted lateral candidates.\n     #[serde(default, skip_serializing_if = \"Option::is_none\")]\n     pub lateral_candidate_margin_m: Option<f64>,\n@@ -155,6 +158,7 @@ impl PipelineConfig {\n             confirm_slow_motion: false,\n             forecast_envelope: None,\n             settle_obstruction_stops: false,\n+            search_obstruction_stops: false,\n             lateral_candidate_margin_m: None,\n             gnss_latency_compensation: false,\n             local_route_geometry: false,\n@@ -173,6 +177,9 @@ impl PipelineConfig {\n         }\n     }\n     pub fn validate(&self) -> Result<(), String> {\n+        if self.search_obstruction_stops && !self.settle_obstruction_stops {\n+            return Err(\"obstruction stop search requires obstruction stop retention\".into());\n+        }\n         if self.absolute_heading_fusion\n             && (self.gnss_latency_compensation || self.relocalization.is_some())\n         {\n@@ -592,6 +599,7 @@ impl DrivingPipeline {\n         planner.local_route_geometry = config.local_route_geometry;\n         planner.point_reference_recovery = config.rear_axle_offset_m.is_none();\n         planner.settle_obstruction_stops = config.settle_obstruction_stops;\n+        planner.search_obstruction_stops = config.search_obstruction_stops;\n         planner.lateral_candidate_margin_m = config.lateral_candidate_margin_m;\n         planner.vehicle = config.vehicle;\n         if let Some(limits) = config.motion_limits {\n@@ -1405,6 +1413,9 @@ impl DrivingPipeline {\n         }\n         let command = if health.is_empty() {\n             let mut requested = self.controller.control(motion_estimate, &trajectory, dt);\n+            if self.planner.braking_obstruction_stop() {\n+                requested.acceleration = requested.acceleration.min(0.0);\n+            }\n             if self\n                 .stop_signs\n                 .as_ref()\ndiff --git a/crates/pipeline/tests/obstruction_stops.rs b/crates/pipeline/tests/obstruction_stops.rs\nindex 2cf0a42..48fcd45 100644\n--- a/crates/pipeline/tests/obstruction_stops.rs\n+++ b/crates/pipeline/tests/obstruction_stops.rs\n@@ -93,3 +93,22 @@ fn omitted_policy_preserves_the_legacy_header_and_rejects_a_nonboolean_value() {\n     value[\"settle_obstruction_stops\"] = serde_json::json!(1);\n     assert!(serde_json::from_value::<PipelineConfig>(value).is_err());\n }\n+\n+#[test]\n+fn stop_search_requires_retention_and_preserves_the_default_header() {\n+    let mut c = config();\n+    assert!(\n+        serde_json::to_value(&c)\n+            .unwrap()\n+            .get(\"search_obstruction_stops\")\n+            .is_none()\n+    );\n+    c.search_obstruction_stops = true;\n+    assert!(c.validate().is_err());\n+    c.settle_obstruction_stops = true;\n+    assert!(c.validate().is_ok());\n+    let mut value = serde_json::to_value(c).unwrap();\n+    assert_eq!(value[\"search_obstruction_stops\"], true);\n+    value[\"search_obstruction_stops\"] = serde_json::json!(1);\n+    assert!(serde_json::from_value::<PipelineConfig>(value).is_err());\n+}\ndiff --git a/crates/planning/src/lib.rs b/crates/planning/src/lib.rs\nindex 744a62a..c5bb9a4 100644\n--- a/crates/planning/src/lib.rs\n+++ b/crates/planning/src/lib.rs\n@@ -4,6 +4,7 @@ mod corners;\n mod geometry;\n mod speed;\n mod speed_zones;\n+mod stopping;\n use rustdriving_core::{\n     DrivingMode, EgoState, Planner, Prediction, Route, Trajectory, VehicleConfig,\n };\n@@ -23,6 +24,9 @@ pub struct LatticePlanner {\n     /// After collision-induced emergency braking, retain a feasible immediate\n     /// stop until a complete unblocked candidate clears the ordinary sweep.\n     pub settle_obstruction_stops: bool,\n+    /// Search earlier reachable stops after the ordinary retimed stop fails its\n+    /// complete collision sweep. Requires obstruction-stop retention.\n+    pub search_obstruction_stops: bool,\n     /// Optional additional road-edge reserve for width-fitted side candidates.