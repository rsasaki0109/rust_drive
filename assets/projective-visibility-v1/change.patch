--- a/integrations/projective-depth/src/visibility.rs
+++ b/integrations/projective-depth/src/visibility.rs
@@ -0,0 +1,185 @@
+//! Accepted acquisition evidence for surfaces lying in measured free space.
+use super::*;
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum Visibility {
+    #[default]
+    Disabled,
+    FreeSpaceDecay,
+}
+
+#[derive(Clone, Debug, Default, Serialize)]
+pub struct VisibilityStats {
+    pub tested: usize,
+    pub consistent: usize,
+    pub occluded: usize,
+    pub free_space: usize,
+    pub removed: usize,
+}
+
+pub(super) fn decay(
+    camera: Camera,
+    model: &mut [f64],
+    weights: &mut [u8],
+    depth: &[f64],
+    normals: &[V],
+    current_from_model: Pose,
+) -> VisibilityStats {
+    let mut stats = VisibilityStats::default();
+    for (i, z) in model.iter_mut().enumerate() {
+        if *z <= MIN_Z || *z >= MAX_Z || weights[i] == 0 {
+            continue;
+        }
+        let query = current_from_model.transform(camera.point(i, *z));
+        if query[2] >= MAX_Z {
+            continue;
+        }
+        let Some(j) = camera.project(query, false) else {
+            continue;
+        };
+        if depth[j] <= MIN_Z || depth[j] >= MAX_Z || dot(normals[j], normals[j]) <= 0.25 {
+            continue;
+        }
+        stats.tested += 1;
+        let gap = depth[j] - query[2];
+        let band = 0.03 + 0.01 * query[2];
+        if gap > band {
+            stats.free_space += 1;
+            weights[i] -= 1;
+            if weights[i] == 0 {
+                *z = 0.;
+                stats.removed += 1;
+            }
+        } else if gap < -band {
+            stats.occluded += 1;
+        } else {
+            stats.consistent += 1;
+        }
+    }
+    stats
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn camera() -> Camera {
+        Camera {
+            width: 32,
+            height: 32,
+            fx: 32.,
+            fy: 32.,
+            cx: 15.5,
+            cy: 15.5,
+        }
+    }
+
+    #[test]
+    fn only_supported_free_space_exhausts_evidence_and_clears_depth() {
+        let mut model = vec![2.; 1024];
+        let mut weights = vec![7; 1024];
+        let mut depth = model.clone();
+        let mut normals = vec![[0., 0., 1.]; 1024];
+        let j = 16 * 32 + 12;
+        model[j..j + 4].copy_from_slice(&[1., 3., 1., 1.]);
+        weights[j..j + 4].copy_from_slice(&[2, 4, 2, 2]);
+        depth[j + 2] = 0.;
+        normals[j + 3] = [0.; 3];
+        let first = decay(
+            camera(),
+            &mut model,
+            &mut weights,
+            &depth,
+            &normals,
+            Pose::identity(),
+        );
+        assert_eq!(
+            (
+                first.tested,
+                first.consistent,
+                first.occluded,
+                first.free_space,
+                first.removed
+            ),
+            (1022, 1020, 1, 1, 0)
+        );
