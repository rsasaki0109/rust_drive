+def normals(depth, ids):
+    y, x = ids//640, ids%640; inside = (x > 0)&(x < 639)&(y > 0)&(y < 479)
+    result = np.zeros((len(ids), 3)); safe = ids[inside]; z = depth.ravel()[safe]
+    valid = (z > .3)&(z < 5)
