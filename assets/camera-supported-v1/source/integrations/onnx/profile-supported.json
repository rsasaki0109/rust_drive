  "policy": {
    "coarse": "Compute unchanged original four-view consistency, keep every coarse detection, score, coordinate, order and origin. For non-road-image shapes use the complete original1..4 prefix.",
    "new_proposals": "Only non-interior-edge detections from supplemental small tiles. Transform to source pixel frame without changing scores or classes.",
    "coarse_veto": "Reject any supplemental proposal at IoU>.45 with any coarse result, regardless of class. Coarse boxes are never removed or replaced.",
