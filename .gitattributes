# Preserve the exact upstream/converted OSM bytes checked by the source oracle.
maps/osm/german-road-extract.osm -text
maps/osm/german-road-extract.json -text
# Frozen evaluation hashes must survive Windows checkout newline conversion.
data/**/manifest.json text eol=lf
assets/*freeze.json text eol=lf
crates/perception/src/terrain_adaptive.rs text eol=lf
crates/localization/src/registration3d.rs text eol=lf
integrations/rgbd/** text eol=lf

# Preserve the byte-pinned upstream data notice, including its original spacing.
assets/recorded-bdd/LICENSE-data.txt -text whitespace=-blank-at-eol
# Keep newly frozen measured-map evidence stable across checkout settings.
assets/recorded-submaps/** text eol=lf
assets/recorded-bdd/*.json text eol=lf
crates/localization/src/submap3d.rs text eol=lf
# Preserve visual-motion source freezes and independent pixel evidence.
assets/recorded-visual/** text eol=lf linguist-generated=true
integrations/rgbd/baselines/visual-sitting-first-v1/** linguist-generated=true
crates/perception/src/image_features.rs text eol=lf
crates/localization/src/visual_odometry3d.rs text eol=lf
crates/perception/src/lib.rs text eol=lf
crates/localization/src/lib.rs text eol=lf
crates/core/src/lib.rs text eol=lf
Cargo.lock text eol=lf
rust-toolchain.toml text eol=lf
scripts/check-recorded-*.py text eol=lf
scripts/fetch-visual-datasets.py text eol=lf
scripts/requirements-visual.txt text eol=lf
